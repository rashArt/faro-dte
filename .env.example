# ============================================
# DTE Chile API - Configuración
# ============================================
# Copiar este archivo como .env y completar los valores

# ---- Servidor ----
APP_NAME=DTE Chile API
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ---- SII Chile ----
# Ambiente: certificacion (maullin) o produccion (palena)
SII_AMBIENTE=certificacion

# Datos de resolución SII (obtenidos al autorizar emisión electrónica)
SII_FECHA_RESOLUCION=2014-08-22
SII_NUMERO_RESOLUCION=80

# ---- Empresa (Emisor por defecto) ----
# RUT de la empresa sin puntos con guión (ej: 76543210-5)
EMPRESA_RUT=
EMPRESA_RAZON_SOCIAL=
EMPRESA_GIRO=
EMPRESA_CODIGO_ACTIVIDAD=
EMPRESA_DIRECCION=
EMPRESA_COMUNA=
EMPRESA_CIUDAD=
EMPRESA_EMAIL=
EMPRESA_TELEFONO=

# ---- Certificado Digital ----
# Ruta al archivo .p12/.pfx del certificado (opcional, se puede enviar por API)
CERTIFICADO_PATH=
CERTIFICADO_PASSWORD=

# ---- Base de Datos ----
# SQLite o PostgreSQL (solo el motor Python; Go y Rust siguen con SQLite). Ejemplos:
#   DATABASE_URL=sqlite:///./dte_database.db
#   DATABASE_URL=postgresql+psycopg://faro:<clave>@db:5432/faro
# El esquema lo crean las migraciones de Alembic (`alembic upgrade head`; también al arrancar).
# Ver docs/deploy/POSTGRESQL.md. En Docker la fija el compose: PostgreSQL en
# docker-compose.dev.yml y docker-compose.prod.yml (clave POSTGRES_PASSWORD; en dev, por defecto
# faro-local). Con SQLite en Docker: sqlite:////app/storage/dte_database.db (dentro del volumen).
# POSTGRES_PASSWORD=
DATABASE_URL=sqlite:///./dte_database.db

# ---- Emisión (docs/deploy/PLAN.md, "Política de folios") ----
# Minutos tras los que una reserva de folio sin timbre (el proceso cayó a mitad) se reusa.
# EMISION_PLAZO_RESERVA_MIN=10

# ---- Caché (docs/deploy/PLAN.md, fase 3) ----
# Opcional. Sin REDIS_URL, el token del SII se guarda en la memoria del proceso. Con varios
# procesos o réplicas, Redis lo comparte (valores cifrados con DTE_MASTER_KEY).
# REDIS_URL=redis://redis:6379/0

# ---- Despacho al SII (docs/deploy/PLAN.md, fase 5; docs/deploy/INTEGRACION.md) ----
# desactivado (por defecto): se emite y se entrega el PDF, pero NADA sale al SII. Para desarrollar
# con el CAF y el certificado ficticios. En certificación y producción: activo (Faro envía lo
# emitido con `enviar` y sigue el veredicto en segundo plano).
# ENVIO_SII=desactivado
# Cada cuántos segundos revisa el despacho; envíos fallidos seguidos antes de `envio_fallido`;
# horas sin veredicto antes de `sin_veredicto`.
# DESPACHO_INTERVALO_SEG=15
# ENVIO_MAX_INTENTOS=8
# VEREDICTO_ALERTA_HORAS=6

# ---- Límites de acceso (docs/deploy/PLAN.md, fase 4) ----
# Logins fallidos por usuario+IP antes de bloquear ese par, y minutos de bloqueo (429 + Retry-After).
# LOGIN_MAX_FALLOS=5
# LOGIN_BLOQUEO_MIN=15
# Bearer inválidos por IP antes de que los inválidos respondan 429 (los válidos pasan siempre).
# BEARER_MAX_FALLOS=20
# Largo mínimo de una contraseña nueva (registro y POST /auth/cambiar-clave).
# CLAVE_LARGO_MINIMO=12

# ---- Usuario admin (solo primer arranque) ----
# Si no la defines, se genera una aleatoria y se imprime UNA vez en el log. En Docker llega al
# proceso por `env_file` (docker-compose.dev.yml); main.py la lee del entorno.
# ADMIN_PASSWORD=

# ---- Seguridad / JWT ----
# `setup.py` GENERA valores fuertes para JWT_SECRET_KEY y DTE_MASTER_KEY. Si editas a
# mano, pon secretos aleatorios (>=32 chars). En producción, la app NO arranca con estos
# placeholders. Genera JWT con: openssl rand -hex 32
JWT_SECRET_KEY=cambiar_esto_por_una_clave_segura_de_al_menos_32_caracteres
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Clave Fernet que cifra los certificados del keystore. Genera con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OJO: si la cambias, los certificados YA guardados no se podrán descifrar (re-súbelos).
DTE_MASTER_KEY=

# ---- CORS ----
# Orígenes permitidos (separados por coma). Con "*" se DESHABILITAN las credenciales
# (regla CORS). Para uso local/self-hosted restringe a tu origen, ej:
#   CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ORIGINS=*

# ---- Logs ----
LOG_LEVEL=INFO
LOG_FILE=logs/dte_api.log

# ---- Almacenamiento de archivos ----
# Directorio para guardar DTEs emitidos, PDFs, etc.
STORAGE_PATH=./storage

# Token del endpoint de correos del SII (skill correos-sii). Lo rota el usuario.
SII_MAIL_TOKEN=

# Nombre(s) con que este motor está registrado en el SII como software de facturación (separados por coma).
# Con esto el panel distingue "emite con este motor" de "emite con otro proveedor" (Nubox, Bsale, Haulmer…).
NOMBRE_SOFTWARE=

# APP_SHELL_KEY: NO la definas aquí. La genera la app de escritorio (app/) en cada arranque y
# se la pasa al motor por entorno; autentica como el usuario dueño. Ver docs/APP.md.
