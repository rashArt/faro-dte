# Empresa — Faro API (motor Python)
# GENERADO por tools/generar_http.py desde /openapi.json. No editar a mano: regenerar.
# Requiere la extensión REST Client (humao.rest-client) y el entorno "local" (abajo a la
# derecha en VS Code, o Ctrl+Alt+E). Claves en http/.env (copia http/env.ejemplo).

@clave = {{$dotenv FARO_CLAVE}}
@clave_cert = {{$dotenv FARO_CLAVE_CERT}}

### Iniciar sesión (ejecuta esto primero; el token dura 60 min)
# @name login
POST {{base}}/api/v1/auth/login
Content-Type: application/json

{"username": "{{usuario}}", "password": "{{clave}}"}

###
@token = {{login.response.body.access_token}}

### La empresa de la instancia: datos, ambiente, certificado y qué falta para producción
# opcionales: consultar_sii=False
# @name ver_empresa_api_v1_empresa_get
GET {{base}}/api/v1/empresa
Authorization: Bearer {{token}}

### Crear la empresa o actualizar sus datos (solo administrador)
# @name guardar_empresa_api_v1_empresa_put
PUT {{base}}/api/v1/empresa
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rut": "77777777-7",
  "razon_social": "EMPRESA DEMO SPA",
  "giro": "Cafetería",
  "codigo_actividad": 561000,
  "direccion": "Calle Ficticia 123",
  "comuna": "Santiago",
  "ciudad": "Santiago",
  "email": "hola@empresademo.cl",
  "telefono": "<telefono>"
}

### Subir el certificado digital con que firma la empresa (solo administrador)
# @name subir_certificado_api_v1_empresa_certificado_put
PUT {{base}}/api/v1/empresa/certificado
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=FaroLimite

--FaroLimite
Content-Disposition: form-data; name="archivo"; filename="cert_demo.p12"
Content-Type: application/octet-stream

< ../../tests/dorado/fixtures/cert_demo.p12
--FaroLimite
Content-Disposition: form-data; name="password"

{{clave_cert}}
--FaroLimite--

### Cambiar el ambiente de la empresa: demo, certificación o producción (solo administrador)
# @name cambiar_ambiente_api_v1_empresa_ambiente_put
PUT {{base}}/api/v1/empresa/ambiente
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ambiente": "certificacion",
  "confirmar_rut": "<confirmar_rut>"
}

### Folios disponibles por tipo de documento y vencimiento de cada CAF
# opcionales: ambiente=certificacion
# @name ver_folios_api_v1_empresa_folios_get
GET {{base}}/api/v1/empresa/folios
Authorization: Bearer {{token}}
