# Estado DTE en SII — Faro API (motor Python)
# GENERADO por tools/generar_http.py desde /openapi.json. No editar a mano: regenerar.
# Requiere la extensión REST Client (humao.rest-client) y el entorno "local" (abajo a la
# derecha en VS Code, o Ctrl+Alt+E). Claves en http/.env (copia http/env.ejemplo).

@clave = {{$dotenv FARO_CLAVE}}
@clave_cert = {{$dotenv FARO_CLAVE_CERT}}

### Iniciar sesión (ejecuta esto primero; el token dura 60 min)
# @name login
POST {{base}}/api/v1/auth/login
Content-Type: application/json

{"username": "{{usuario}}", "password": "{{clave}}"}

###
@token = {{login.response.body.access_token}}

### Consultar estado de envío por TrackID
# @name consultar_estado_track_api_v1_estado_track_post
POST {{base}}/api/v1/estado/track
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "track_id": 0,
  "rut_empresa": "77777777-7",
  "dv_empresa": "7",
  "certificado_p12_b64": "<certificado_p12_b64>",
  "password_certificado": "<password_certificado>"
}

### Estado de varios envíos por TrackID (con resumen)
# @name consultar_estado_lote_api_v1_estado_lote_post
POST {{base}}/api/v1/estado/lote
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "track_ids": [
    1
  ],
  "rut_empresa": "77777777-7",
  "cert_id": 1
}

### Consultar estado de un DTE específico
# @name consultar_estado_dte_api_v1_estado_dte_post
POST {{base}}/api/v1/estado/dte
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rut_emisor": "77777777-7",
  "dv_emisor": "7",
  "tipo_dte": 33,
  "folio": 0,
  "fecha_emision": "<fecha_emision>",
  "monto_total": 1,
  "rut_receptor": "76111111-6",
  "dv_receptor": "<dv_receptor>",
  "certificado_p12_b64": "<certificado_p12_b64>",
  "password_certificado": "<password_certificado>"
}
