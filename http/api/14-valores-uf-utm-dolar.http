# Valores (UF, UTM, dólar) — Faro API (motor Python)
# GENERADO por tools/generar_http.py desde /openapi.json. No editar a mano: regenerar.
# Requiere la extensión REST Client (humao.rest-client) y el entorno "local" (abajo a la
# derecha en VS Code, o Ctrl+Alt+E). Claves en http/.env (copia http/env.ejemplo).

@clave = {{$dotenv FARO_CLAVE}}
@clave_cert = {{$dotenv FARO_CLAVE_CERT}}
@indicador = 1

### Iniciar sesión (ejecuta esto primero; el token dura 60 min)
# @name login
POST {{base}}/api/v1/auth/login
Content-Type: application/json

{"username": "{{usuario}}", "password": "{{clave}}"}

###
@token = {{login.response.body.access_token}}

### UF, UTM y dólar vigentes a una fecha (hoy por defecto)
# opcionales: fecha=<fecha>
# @name valores_vigentes_api_v1_valores_get
GET {{base}}/api/v1/valores
Authorization: Bearer {{token}}

### Tabla mensual de un año: UF y dólar al día 1 (vigentes) y UTM del mes
# @name historico_api_v1_valores_historico_get
GET {{base}}/api/v1/valores/historico
    ?anio=1
Authorization: Bearer {{token}}

### Serie diaria/mensual de un indicador entre dos fechas
# @name serie_api_v1_valores_indicador_serie_get
GET {{base}}/api/v1/valores/{{indicador}}/serie
    ?desde=<desde>
    &hasta=<hasta>
Authorization: Bearer {{token}}

### Un indicador vigente a una fecha, con la fecha real del valor
# opcionales: fecha=<fecha>
# @name valor_vigente_api_v1_valores_indicador_get
GET {{base}}/api/v1/valores/{{indicador}}
Authorization: Bearer {{token}}
