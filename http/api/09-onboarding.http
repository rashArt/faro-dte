# Onboarding — Faro API (motor Python)
# GENERADO por tools/generar_http.py desde /openapi.json. No editar a mano: regenerar.
# Requiere la extensión REST Client (humao.rest-client). Dirección y claves en http/.env
# (copia http/env.ejemplo).

@base = {{$dotenv BASE_URL}}
@clave = {{$dotenv FARO_CLAVE}}
@clave_cert = {{$dotenv FARO_CLAVE_CERT}}

### Iniciar sesión (ejecuta esto primero; el token dura 60 min)
# @name login
POST {{base}}/api/v1/auth/login
Content-Type: application/json

{"username": "admin", "password": "{{clave}}"}

###
@token = {{login.response.body.access_token}}

### Diagnostico
# opcionales: nombre_sistema=tu software propio
# @name diagnostico_api_v1_onboarding_diagnostico_get
GET {{base}}/api/v1/onboarding/diagnostico
    ?cert_id=1
    &rut=77777777-7
Authorization: Bearer {{token}}

### Cartera
# opcionales: nombre_sistema=tu software propio
# @name cartera_api_v1_onboarding_cartera_get
GET {{base}}/api/v1/onboarding/cartera
    ?cert_id=1
Authorization: Bearer {{token}}
