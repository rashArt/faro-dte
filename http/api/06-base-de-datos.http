# Base de Datos — Faro API (motor Python)
# GENERADO por tools/generar_http.py desde /openapi.json. No editar a mano: regenerar.
# Requiere la extensión REST Client (humao.rest-client) y el entorno "local" (abajo a la
# derecha en VS Code, o Ctrl+Alt+E). Claves en http/.env (copia http/env.ejemplo).

@clave = {{$dotenv FARO_CLAVE}}
@clave_cert = {{$dotenv FARO_CLAVE_CERT}}
@dte_id = 1
@rut_emisor = 1
@tipo_dte = 1
@folio = 1

### Iniciar sesión (ejecuta esto primero; el token dura 60 min)
# @name login
POST {{base}}/api/v1/auth/login
Content-Type: application/json

{"username": "{{usuario}}", "password": "{{clave}}"}

###
@token = {{login.response.body.access_token}}

### Listar DTEs emitidos
# opcionales: rut_emisor=77777777-7, tipo_dte=33, estado=<estado>, fecha_desde=<fecha_desde>, fecha_hasta=<fecha_hasta>, limite=100, offset=0
# @name get_dtes_api_v1_db_dtes_get
GET {{base}}/api/v1/db/dtes
Authorization: Bearer {{token}}

### Obtener DTE por ID
# @name get_dte_api_v1_db_dtes_dte_id_get
GET {{base}}/api/v1/db/dtes/{{dte_id}}
Authorization: Bearer {{token}}

### Buscar DTE por emisor, tipo y folio
# @name buscar_dte_api_v1_db_dtes_buscar_rut_emisor_tipo_dte_folio_g
GET {{base}}/api/v1/db/dtes/buscar/{{rut_emisor}}/{{tipo_dte}}/{{folio}}
Authorization: Bearer {{token}}

### Listar CAFs registrados
# opcionales: rut_emisor=77777777-7, tipo_dte=33
# @name get_cafs_api_v1_db_cafs_get
GET {{base}}/api/v1/db/cafs
Authorization: Bearer {{token}}

### Registrar un nuevo CAF subiendo el XML
# @name post_registrar_caf_api_v1_db_cafs_post
POST {{base}}/api/v1/db/cafs
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=FaroLimite

--FaroLimite
Content-Disposition: form-data; name="archivo"; filename="caf_33.xml"
Content-Type: application/octet-stream

< ../../tests/dorado/fixtures/caf_33.xml
--FaroLimite--

### Obtener CAF activo
# @name get_caf_activo_api_v1_db_cafs_activo_rut_emisor_tipo_dte_get
GET {{base}}/api/v1/db/cafs/activo/{{rut_emisor}}/{{tipo_dte}}
Authorization: Bearer {{token}}

### Obtener siguiente folio disponible
# @name get_siguiente_folio_api_v1_db_folios_siguiente_rut_emisor_ti
GET {{base}}/api/v1/db/folios/siguiente/{{rut_emisor}}/{{tipo_dte}}
Authorization: Bearer {{token}}

### Consultar logs de auditoría
# opcionales: accion=<accion>, rut_emisor=77777777-7, fecha_desde=<fecha_desde>, limite=100
# @name get_logs_api_v1_db_logs_get
GET {{base}}/api/v1/db/logs
Authorization: Bearer {{token}}
