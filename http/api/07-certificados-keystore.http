# Certificados (Keystore) — Faro API (motor Python)
# GENERADO por tools/generar_http.py desde /openapi.json. No editar a mano: regenerar.
# Requiere la extensión REST Client (humao.rest-client) y el entorno "local" (abajo a la
# derecha en VS Code, o Ctrl+Alt+E). Claves en http/.env (copia http/env.ejemplo).

@clave = {{$dotenv FARO_CLAVE}}
@clave_cert = {{$dotenv FARO_CLAVE_CERT}}
@cert_id = 1
@negocio_id = 1
@rut_empresa = 1

### Iniciar sesión (ejecuta esto primero; el token dura 60 min)
# @name login
POST {{base}}/api/v1/auth/login
Content-Type: application/json

{"username": "{{usuario}}", "password": "{{clave}}"}

###
@token = {{login.response.body.access_token}}

### Listar Certificados
# @name listar_certificados_api_v1_keystore_certificados_get
GET {{base}}/api/v1/keystore/certificados
Authorization: Bearer {{token}}

### Subir Certificado
# @name subir_certificado_api_v1_keystore_certificados_post
POST {{base}}/api/v1/keystore/certificados
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=FaroLimite

--FaroLimite
Content-Disposition: form-data; name="archivo"; filename="cert_demo.p12"
Content-Type: application/octet-stream

< ../../tests/dorado/fixtures/cert_demo.p12
--FaroLimite
Content-Disposition: form-data; name="password"

{{clave_cert}}
--FaroLimite--

### Eliminar Certificado
# @name eliminar_certificado_api_v1_keystore_certificados_cert_id_de
DELETE {{base}}/api/v1/keystore/certificados/{{cert_id}}
Authorization: Bearer {{token}}

### Empresas Del Certificado
# @name empresas_del_certificado_api_v1_keystore_certificados_cert_i
GET {{base}}/api/v1/keystore/certificados/{{cert_id}}/empresas
Authorization: Bearer {{token}}

### Previsualizar Empresa
# opcionales: ambiente=certificacion
# @name previsualizar_empresa_api_v1_keystore_empresa_get
GET {{base}}/api/v1/keystore/empresa
    ?rut=77777777-7
Authorization: Bearer {{token}}

### Listar Negocios
# @name listar_negocios_api_v1_keystore_negocios_get
GET {{base}}/api/v1/keystore/negocios
Authorization: Bearer {{token}}

### Agregar Negocio
# @name agregar_negocio_api_v1_keystore_negocios_post
POST {{base}}/api/v1/keystore/negocios
Authorization: Bearer {{token}}
Content-Type: application/x-www-form-urlencoded

rut=77777777-7

### Guardar los datos del emisor de un negocio (giro, dirección, código de actividad…)
# @name actualizar_negocio_api_v1_keystore_negocios_negocio_id_put
PUT {{base}}/api/v1/keystore/negocios/{{negocio_id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "razon_social": "EMPRESA DEMO SPA",
  "giro": "Cafetería",
  "codigo_actividad": 561000,
  "direccion": "Calle Ficticia 123",
  "comuna": "Santiago",
  "ciudad": "Santiago",
  "email": "hola@empresademo.cl",
  "telefono": "<telefono>"
}

### Eliminar Negocio
# @name eliminar_negocio_api_v1_keystore_negocios_negocio_id_delete
DELETE {{base}}/api/v1/keystore/negocios/{{negocio_id}}
Authorization: Bearer {{token}}

### Timbraje Negocio
# @name timbraje_negocio_api_v1_keystore_negocios_negocio_id_timbraj
GET {{base}}/api/v1/keystore/negocios/{{negocio_id}}/timbraje
Authorization: Bearer {{token}}

### Recordar (cifradas) las claves del SII de una empresa del gratuito
# @name guardar_claves_sii_api_v1_keystore_claves_sii_put
PUT {{base}}/api/v1/keystore/claves-sii
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rut_empresa": "77777777-7"
}

### Qué claves del SII hay recordadas para la empresa (sin valores)
# @name estado_claves_sii_api_v1_keystore_claves_sii_rut_empresa_get
GET {{base}}/api/v1/keystore/claves-sii/{{rut_empresa}}
Authorization: Bearer {{token}}

### Olvidar las claves del SII de la empresa
# @name olvidar_claves_sii_api_v1_keystore_claves_sii_rut_empresa_de
DELETE {{base}}/api/v1/keystore/claves-sii/{{rut_empresa}}
Authorization: Bearer {{token}}

### Lo que el núcleo (Go) necesita para emitir por este negocio: certificado en PEM, resolución, rutas
# @name contexto_emision_api_v1_keystore_negocios_negocio_id_context
GET {{base}}/api/v1/keystore/negocios/{{negocio_id}}/contexto-emision
Authorization: Bearer {{token}}

### Estado Negocio
# @name estado_negocio_api_v1_keystore_negocios_negocio_id_estado_ge
GET {{base}}/api/v1/keystore/negocios/{{negocio_id}}/estado
Authorization: Bearer {{token}}

### F29 Negocio
# opcionales: ppm=0, remanente_anterior=0
# @name f29_negocio_api_v1_keystore_negocios_negocio_id_f29_get
GET {{base}}/api/v1/keystore/negocios/{{negocio_id}}/f29
    ?periodo=<periodo>
Authorization: Bearer {{token}}
