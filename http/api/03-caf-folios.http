# CAF - Folios — Faro API (motor Python)
# GENERADO por tools/generar_http.py desde /openapi.json. No editar a mano: regenerar.
# Requiere la extensión REST Client (humao.rest-client) y el entorno "local" (abajo a la
# derecha en VS Code, o Ctrl+Alt+E). Claves en http/.env (copia http/env.ejemplo).

@clave = {{$dotenv FARO_CLAVE}}
@clave_cert = {{$dotenv FARO_CLAVE_CERT}}
@rut_emisor = 1
@tipo_dte = 1

### Iniciar sesión (ejecuta esto primero; el token dura 60 min)
# @name login
POST {{base}}/api/v1/auth/login
Content-Type: application/json

{"username": "{{usuario}}", "password": "{{clave}}"}

###
@token = {{login.response.body.access_token}}

### Obtener información de un archivo CAF
# @name info_caf_api_v1_caf_info_post
POST {{base}}/api/v1/caf/info
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=FaroLimite

--FaroLimite
Content-Disposition: form-data; name="archivo"; filename="caf_33.xml"
Content-Type: application/octet-stream

< ../../tests/dorado/fixtures/caf_33.xml
--FaroLimite--

### Validar si un folio está autorizado en un CAF
# @name validar_folio_api_v1_caf_validar_folio_post
POST {{base}}/api/v1/caf/validar-folio
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "caf_xml_b64": "<caf_xml_b64>",
  "folio": 0
}

### Listar CAF registrados
# opcionales: rut_emisor=77777777-7, tipo_dte=33
# @name get_cafs_api_v1_caf_get
GET {{base}}/api/v1/caf
Authorization: Bearer {{token}}

### Registrar un CAF subiendo el XML del SII
# @name post_registrar_caf_api_v1_caf_post
POST {{base}}/api/v1/caf
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=FaroLimite

--FaroLimite
Content-Disposition: form-data; name="archivo"; filename="caf_33.xml"
Content-Type: application/octet-stream

< ../../tests/dorado/fixtures/caf_33.xml
--FaroLimite--

### CAF activo de un emisor y tipo
# @name get_caf_activo_api_v1_caf_activo_rut_emisor_tipo_dte_get
GET {{base}}/api/v1/caf/activo/{{rut_emisor}}/{{tipo_dte}}
Authorization: Bearer {{token}}

### Siguiente folio disponible
# @name get_siguiente_folio_api_v1_caf_folios_siguiente_rut_emisor_t
GET {{base}}/api/v1/caf/folios/siguiente/{{rut_emisor}}/{{tipo_dte}}
Authorization: Bearer {{token}}
