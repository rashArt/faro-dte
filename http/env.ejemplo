# Copia este archivo como http/.env (ignorado por git). Lo leen los .http con {{$dotenv ...}}.
# Clave del usuario admin de TU instancia local (ADMIN_PASSWORD del .env de la raíz).
FARO_CLAVE=
# Clave del certificado que subes por /keystore/certificados. El certificado FICTICIO del
# corpus (tests/dorado/fixtures/cert_demo.p12) usa "demo".
FARO_CLAVE_CERT=demo
