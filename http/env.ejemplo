# Copia este archivo como http/.env (ignorado por git). Lo leen todos los .http con {{$dotenv ...}}.

# Dirección de la instancia: local (http://127.0.0.1:8000, no "localhost") o la de tu servidor.
BASE_URL=http://127.0.0.1:8000
# Clave del usuario admin de esa instancia (ADMIN_PASSWORD de su .env).
FARO_CLAVE=
# Clave del certificado FICTICIO del corpus (tests/dorado/fixtures/cert_demo.p12).
FARO_CLAVE_CERT=demo
# Token de tu sistema: la "api_key" que devuelve el paso 8 de flujos/01-configurar.http.
FARO_TOKEN=
