# ============================================
# Faro - .env de UNA instancia de cliente (servidor)
# ============================================
# Copiar como `.env` en la carpeta del cliente (chmod 600), junto a docker-compose.yml (copia de
# docker-compose.prod.yml). Ver docs/deploy/README.md.
# Los valores entre <> se generan por cliente; nunca reutilices secretos entre instancias.
# Este archivo va en cada respaldo (tools/respaldo.sh): guárdalos protegidos.

# ---- Instancia (los lee docker compose) ----
# Nombre del proyecto: prefijo de contenedores y volúmenes, y nombre con que tus integraciones
# llaman a la API en la red `integraciones` (http://faro-acme:8000).
COMPOSE_PROJECT_NAME=faro-<cliente>
# Imagen publicada en el registro y su versión: la de la etiqueta de git (servidor-v1.2.0 -> 1.2.0).
# Nunca "latest": la versión fija dice qué corre cada cliente y permite volver atrás.
FARO_IMAGEN=<usuario de Docker Hub>/faro-dte
FARO_VERSION=<versión, p. ej. 1.2.0>

# ---- Servidor ----
APP_NAME=Faro
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=logs/dte_api.log
STORAGE_PATH=./storage

# ---- SII ----
# activo: Faro envía al SII lo emitido y sigue el veredicto. desactivado: se emite y se entrega
# el PDF, pero nada sale al SII (solo para pruebas con datos ficticios).
ENVIO_SII=activo
# El ambiente NO va aquí: es de la empresa y se cambia por la API (PUT /api/v1/empresa/ambiente).
# Una empresa nueva nace en modo demo (simulacion): nada sale al SII ni se le consulta el RUT.
# El administrador la pasa a certificación (ahí se valida el RUT en el SII) y luego a producción.

# ---- Base de datos ----
# PostgreSQL del compose. La URL la arma el compose con esta clave; no definas DATABASE_URL aquí.
# Solo letras y números (va dentro de una URL): openssl rand -hex 24
POSTGRES_PASSWORD=<openssl rand -hex 24>

# ---- Secretos (obligatorios; en produccion el motor no arranca sin ellos) ----
JWT_SECRET_KEY=<openssl rand -hex 32>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Cifra los certificados del keystore. Respáldala FUERA del servidor. Para cambiarla usa
# rotar_claves.py; cambiarla a mano deja los certificados guardados ilegibles.
DTE_MASTER_KEY=<openssl rand -base64 32 | tr '+/' '-_'>
# Clave del usuario admin, solo en el primer arranque. Después cámbiala o bórrala de aquí.
ADMIN_PASSWORD=<openssl rand -base64 18>

# ---- CORS ----
# Tus integraciones llaman desde su backend (servidor a servidor), así que CORS no aplica. Déjalo
# en un origen que no exista para que ningún navegador pueda llamar a la API.
CORS_ORIGINS=https://sin-acceso-desde-navegador.ejemplo.cl

# ---- Automatismos (corren dentro del proceso: un solo proceso de uvicorn) ----
# El RVD diario y la reposición de folios hablan con el SII con el certificado del cliente.
RVD_SCHEDULER_ACTIVO=true
FOLIOS_AUTO_ACTIVO=true
FOLIOS_AUTO_TIPOS=39,41
FOLIOS_AUTO_UMBRAL=10
FOLIOS_AUTO_CANTIDAD=50
# A dónde avisar eventos de folios (folios_repuesto / folios_bloqueado / folios_error).
NOTIF_WEBHOOK_URL=

# ---- Caché (opcional) ----
# Solo con varios procesos o réplicas; descomenta también el servicio `redis` del compose.
# REDIS_URL=redis://redis:6379/0

# ---- Software registrado en el SII (opcional) ----
NOMBRE_SOFTWARE=

# Los datos de la empresa, su certificado y sus folios no van en este archivo: se cargan por la
# API (PUT /api/v1/empresa, PUT /api/v1/empresa/certificado, POST /api/v1/caf).
