# ============================================
# Faro - .env de UNA instancia de cliente (servidor)
# ============================================
# Copiar como `.env` en la carpeta del cliente (chmod 600). Ver docs/deploy/README.md.
# Los valores entre <> se generan por cliente; nunca reutilices secretos entre instancias.

# ---- Servidor ----
APP_NAME=Faro
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=logs/dte_api.log
STORAGE_PATH=./storage

# ---- SII ----
# certificacion (Maullín, sin efecto tributario) hasta terminar la certificación del cliente;
# después produccion (Palena: documentos REALES, L1 de docs/CONSTITUCION.md).
SII_AMBIENTE=certificacion
# La resolución de la carátula se obtiene por RUT del emisor (core/resolucion.py, L4). Estos son
# solo el respaldo si la consulta al SII falla: déjalos como están salvo indicación del SII.
SII_FECHA_RESOLUCION=2014-08-22
SII_NUMERO_RESOLUCION=80

# ---- Base de datos ----
# La fija el compose (DATABASE_URL=sqlite:////app/storage/dte_database.db) para que quede en el
# volumen. No la definas aquí.

# ---- Secretos (obligatorios; en produccion el motor no arranca sin ellos) ----
JWT_SECRET_KEY=<openssl rand -hex 32>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Cifra los certificados del keystore. Respáldala FUERA del servidor. Para cambiarla usa
# rotar_claves.py; cambiarla a mano deja los certificados guardados ilegibles.
DTE_MASTER_KEY=<openssl rand -base64 32 | tr '+/' '-_'>
# Clave del usuario admin, solo en el primer arranque. Después cámbiala o bórrala de aquí.
ADMIN_PASSWORD=<openssl rand -base64 18>

# ---- CORS ----
# Tus integraciones llaman desde su backend (servidor a servidor), así que CORS no aplica. Déjalo
# en un origen que no exista para que ningún navegador pueda llamar a la API.
CORS_ORIGINS=https://sin-acceso-desde-navegador.ejemplo.cl

# ---- Buscador público (opcional) ----
# Solo si Traefik publica el buscador de Faro. Ese host ve SOLO /consulta*. Vacío = sin host público.
DOMINIO_PUBLICO_BOLETAS=

# ---- Automatismos (corren dentro del proceso: un solo worker) ----
RVD_SCHEDULER_ACTIVO=true
FOLIOS_AUTO_ACTIVO=true
FOLIOS_AUTO_TIPOS=39,41
FOLIOS_AUTO_UMBRAL=10
FOLIOS_AUTO_CANTIDAD=50
# A dónde avisar eventos de folios (folios_repuesto / folios_bloqueado / folios_error).
NOTIF_WEBHOOK_URL=

# ---- Software registrado en el SII (opcional) ----
NOMBRE_SOFTWARE=

# ---- Heredado: NO usar ----
# Los datos del emisor son por negocio (POST/PUT /api/v1/keystore/negocios). EMPRESA_* y
# CERTIFICADO_PATH/CERTIFICADO_PASSWORD son de instalaciones viejas; ver docs/deploy/INTEGRACION.md.
