{
  // REST Client (http/**/*.http): la dirección y las claves se leen de http/.env (BASE_URL,
  // FARO_CLAVE…; ignorado por git, plantilla en http/env.ejemplo). No hace falta elegir entorno.
  // Esta rama se trabaja con Docker: la terminal NO activa .venv sola. Si la necesitas:
  //   .venv\Scripts\Activate.ps1   (o llama a .venv\Scripts\python directo)
  "python.terminal.activateEnvironment": false,
  "python-envs.terminal.autoActivationType": "off"
}
